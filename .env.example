# AWS Bedrock Configuration for Amazon Nova Pro
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Optional if using standard ~/.aws/credentials or IAM role
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
# AWS_SESSION_TOKEN=your_session_token_here (if using temporary credentials)

# Bedrock Model Configuration
# Primary: Amazon Nova Pro (native AWS 1st party model, no third-party consent required)
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Fallback: Amazon Nova Lite (faster, lower cost)
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
